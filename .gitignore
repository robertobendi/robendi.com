# --- Pebblestack: per-install state (never commit) ---
/data/*.sqlite
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm
/data/installed.lock
/data/cache/

# User uploads, but keep the security .htaccess + keepfile.
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# --- Legacy React (archived in _legacy_react/) ---
/_legacy_react/node_modules
/_legacy_react/build
/_legacy_react/.pnp
/_legacy_react/.pnp.js
/_legacy_react/coverage
/_legacy_react/.env.local
/_legacy_react/.env.development.local
/_legacy_react/.env.test.local
/_legacy_react/.env.production.local
/_legacy_react/npm-debug.log*
/_legacy_react/yarn-debug.log*
/_legacy_react/yarn-error.log*

# --- Editor / OS clutter ---
.DS_Store
.idea/
.vscode/
*.log

# Node / build output
/node_modules
/build
