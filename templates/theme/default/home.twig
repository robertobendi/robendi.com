{% extends '@theme/layout.twig' %}

{% block title %}Roberto Bendinelli — Developer & Digital Creator{% endblock %}

{% block head %}
<meta name="description" content="Roberto Bendinelli — software engineer working on web, mobile, immersive tech, and privacy systems. Selected work, writing, and press.">
<style>
    /* ---------- hero ---------- */
    .hero {
        min-height: 92vh;
        display: flex;
        align-items: center;
        padding: 8rem 0 4rem;
        position: relative;
    }
    .hero-inner { max-width: 980px; }
    .hero h1 {
        font-size: clamp(3rem, 11vw, 8.5rem);
        line-height: .98;
        letter-spacing: -.03em;
        margin: 1.5rem 0 1.75rem;
    }
    .hero h1 em {
        font-style: italic;
        color: transparent;
        background: var(--gradient);
        -webkit-background-clip: text;
        background-clip: text;
    }
    .hero .lede { font-size: clamp(1.125rem, 2vw, 1.5rem); max-width: 56ch; margin-bottom: 2.5rem; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; }

    /* scroll hint */
    .scroll-hint {
        position: absolute;
        bottom: 2rem; left: 50%;
        transform: translateX(-50%);
        color: var(--text-mute);
        font-size: .75rem;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: .15em;
        text-transform: uppercase;
        animation: float 2.5s ease-in-out infinite;
    }
    @keyframes float {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: .7; }
        50% { transform: translateX(-50%) translateY(6px); opacity: 1; }
    }

    /* ---------- section header ---------- */
    .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 3rem;
        flex-wrap: wrap;
    }
    .section-head .meta { margin-bottom: .5rem; }
    .section-head h2 { margin: 0; }
    .section-head .more {
        color: var(--text-soft);
        font-size: .9375rem;
        border-bottom: 1px solid var(--line-strong);
        padding-bottom: 2px;
    }
    .section-head .more:hover { color: var(--accent); border-color: var(--accent); }

    /* ---------- services ---------- */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
    }
    .service {
        padding: 2rem;
        background: var(--ink-1);
        transition: background .25s var(--easing);
    }
    .service:hover { background: var(--ink-2); }
    .service .num {
        font-family: 'JetBrains Mono', monospace;
        font-size: .75rem;
        color: var(--text-mute);
        letter-spacing: .1em;
        margin-bottom: 1rem;
        display: block;
    }
    .service h3 { margin: 0 0 .5rem; font-size: 1.5rem; }
    .service p { margin: 0; color: var(--text-soft); font-size: .9375rem; }

    /* ---------- featured projects ---------- */
    .projects-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }
    .project-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--ink-1);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        transition: all .35s var(--easing);
        color: inherit;
    }
    .project-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-2);
        box-shadow: var(--shadow-glow);
        color: inherit;
    }
    .project-card .cover {
        aspect-ratio: 16/10;
        background: linear-gradient(135deg, var(--ink-2), var(--ink-3));
        background-size: cover;
        background-position: center;
        position: relative;
    }
    .project-card .cover::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 50%, rgba(7,7,13,.7) 100%);
    }
    .project-card .body { padding: 1.5rem; }
    .project-card h3 { margin: 0 0 .5rem; font-size: 1.5rem; }
    .project-card p { margin: 0; color: var(--text-soft); font-size: .9375rem; }
    .project-card .tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1rem; }
    .project-card .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: .7rem;
        color: var(--text-mute);
        padding: .15rem .5rem;
        border: 1px solid var(--line);
        border-radius: 4px;
    }

    /* ---------- posts list (compact) ---------- */
    .post-row {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 2rem;
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--line);
        align-items: baseline;
        color: inherit;
    }
    .post-row:hover { color: inherit; }
    .post-row:hover h3 { color: var(--accent); }
    .post-row .date { color: var(--text-mute); font-family: 'JetBrains Mono', monospace; font-size: .8125rem; }
    .post-row h3 { margin: 0; font-size: 1.5rem; transition: color .25s var(--easing); }
    .post-row .arrow { color: var(--text-mute); transition: color .25s var(--easing); }
    .post-row:hover .arrow { color: var(--accent); }
    @media (max-width: 600px) {
        .post-row { grid-template-columns: 1fr; gap: .25rem; padding: 1.25rem 0; }
    }

    /* ---------- award badge ---------- */
    .award-badge {
        position: absolute;
        top: 1rem; left: 1rem;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .65rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(255,200,80,.95), rgba(255,140,60,.95));
        color: #1a1100;
        font-family: 'JetBrains Mono', monospace;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .02em;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,220,140,.5);
        box-shadow: 0 4px 16px rgba(255,140,60,.3);
        max-width: calc(100% - 2rem);
    }
    .award-badge svg { flex-shrink: 0; }
</style>
{% endblock %}

{% block content %}
<section class="hero">
    <div class="wrap">
        <div class="hero-inner">
            <span class="pill" data-reveal><span class="pulse"></span>Available for select projects</span>
            <h1 data-reveal>Hi, I'm Roberto. I build <em>software</em> — sometimes it works.</h1>
            <p class="lede" data-reveal>Developer &amp; digital creator working on web apps, mobile, immersive tech, and privacy-first systems. Based in Lausanne. Currently exploring the edges of where AI meets useful software.</p>
            <div class="hero-cta" data-reveal>
                <a href="/projects" class="btn btn-primary">View my work →</a>
                <a href="/contact" class="btn btn-ghost">Get in touch</a>
            </div>
        </div>
    </div>
    <div class="scroll-hint">scroll ↓</div>
</section>

<section>
    <div class="wrap">
        <div class="section-head" data-reveal>
            <div>
                <span class="meta">// what I do</span>
                <h2>Six things I'm <em style="font-family:'Instrument Serif',serif;">good at</em>.</h2>
            </div>
        </div>
        <div class="services-grid" data-reveal>
            <div class="service"><span class="num">01</span><h3>Web Development</h3><p>Modern web apps with React, Vue, and Vite. Performance and UX over framework loyalty.</p></div>
            <div class="service"><span class="num">02</span><h3>Mobile Development</h3><p>React Native and Capacitor apps. Native is faster — this is more fun.</p></div>
            <div class="service"><span class="num">03</span><h3>Full-Stack</h3><p>Frontend, backend, deploy. The whole stack, from the database up to the favicon.</p></div>
            <div class="service"><span class="num">04</span><h3>VR &amp; Immersive</h3><p>Unity / Oculus / WebXR. Sometimes I get motion sick. Worth it.</p></div>
            <div class="service"><span class="num">05</span><h3>Backend &amp; APIs</h3><p>Scalable services and clean REST. GraphQL on request. SQL by default.</p></div>
            <div class="service"><span class="num">06</span><h3>Blockchain &amp; Privacy</h3><p>Zero-knowledge proofs, decentralized systems. No, I won't shill your token.</p></div>
        </div>
    </div>
</section>

<section>
    <div class="wrap">
        <div class="section-head" data-reveal>
            <div>
                <span class="meta">// selected work</span>
                <h2>Things I've shipped.</h2>
            </div>
            <a href="/projects" class="more">All projects →</a>
        </div>
        <div class="projects-strip">
            <a class="project-card" href="/projects/nodepass" data-reveal>
                <span class="award-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    1st · SBB Prize · LauzHack 2025
                </span>
                <div class="cover" style="background-image:linear-gradient(135deg,#6ea8ff22,#b48bff22),url('/uploads/projects/nodepass.webp');"></div>
                <div class="body">
                    <h3>NodePass</h3>
                    <p>A blockchain-based anonymous ticketing system for public transport. NFC verification with full passenger privacy.</p>
                    <div class="tags"><span class="tag">React</span><span class="tag">NFC</span><span class="tag">Blockchain</span></div>
                </div>
            </a>
            <a class="project-card" href="/projects/aether" data-reveal>
                <div class="cover" style="background-image:linear-gradient(135deg,#b48bff22,#ff7ad922),url('/uploads/projects/aether.webp');"></div>
                <div class="body">
                    <h3>Aether</h3>
                    <p>Privacy-first event ticketing on Mina Protocol. ZK proofs validate tickets without revealing identity.</p>
                    <div class="tags"><span class="tag">ZK Proofs</span><span class="tag">Mina</span><span class="tag">Cryptography</span></div>
                </div>
            </a>
            <a class="project-card" href="/projects/lidarxp" data-reveal>
                <div class="cover" style="background-image:linear-gradient(135deg,#6ea8ff22,#ff7ad922),url('/uploads/projects/lidarxp.webp');"></div>
                <div class="body">
                    <h3>LidarXP</h3>
                    <p>VR app turning LiDAR &amp; video into interactive 3D environments — accident reconstruction, multi-user.</p>
                    <div class="tags"><span class="tag">Unity</span><span class="tag">Oculus</span><span class="tag">LiDAR</span></div>
                </div>
            </a>
        </div>
    </div>
</section>

{% if recent_posts is defined and recent_posts|length > 0 %}
<section>
    <div class="wrap">
        <div class="section-head" data-reveal>
            <div>
                <span class="meta">// writing</span>
                <h2>From the blog.</h2>
            </div>
            <a href="/blog" class="more">All posts →</a>
        </div>
        <div data-reveal>
            {% for post in recent_posts|slice(0, 4) %}
                <a class="post-row" href="/blog/{{ post.slug }}">
                    <span class="date">{{ (post.publishAt ?? post.createdAt)|date('M j, Y') }}</span>
                    <h3>{{ post.field('title', '(untitled)') }}</h3>
                    <span class="arrow">→</span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{% endblock %}
