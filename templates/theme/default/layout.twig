<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a12">
    <title>{% block title %}{{ site.name }}{% endblock %}</title>
    {% if meta_description is defined %}
        <meta name="description" content="{{ meta_description }}">
    {% endif %}
    <meta property="og:title" content="{{ block('title') }}">
    {% if meta_description is defined %}
        <meta property="og:description" content="{{ meta_description }}">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink-0: #07070d;
            --ink-1: #0d0d18;
            --ink-2: #14141f;
            --ink-3: #1d1d2c;
            --line: rgba(255,255,255,.07);
            --line-strong: rgba(255,255,255,.14);
            --paper: #f5f1ea;
            --text: #ece8e0;
            --text-soft: #b9b4a8;
            --text-mute: #7d7869;
            --accent: #6ea8ff;
            --accent-2: #b48bff;
            --accent-3: #ff7ad9;
            --gradient: linear-gradient(135deg, #6ea8ff 0%, #b48bff 50%, #ff7ad9 100%);
            --max: 1180px;
            --max-prose: 680px;
            --radius: 14px;
            --radius-sm: 8px;
            --shadow-glow: 0 0 80px rgba(180,139,255,.18);
            --easing: cubic-bezier(.2,.7,.2,1);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
            background: var(--ink-0);
            color: var(--text);
            line-height: 1.6;
            font-size: 16px;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        ::selection { background: var(--accent-2); color: var(--ink-0); }

        h1, h2, h3, h4 {
            font-family: 'Instrument Serif', 'Fraunces', Georgia, serif;
            font-weight: 400;
            letter-spacing: -.015em;
            line-height: 1.05;
            color: var(--text);
            margin: 0 0 .5rem;
        }
        h1 { font-size: clamp(2.5rem, 7vw, 5.5rem); }
        h2 { font-size: clamp(1.875rem, 4vw, 3rem); margin-top: 0; }
        h3 { font-size: clamp(1.375rem, 2.5vw, 1.875rem); }
        h4 { font-size: 1.125rem; font-family: 'Inter', sans-serif; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--text-soft); }

        p, ul, ol, blockquote { margin: 0 0 1.25em; color: var(--text-soft); }
        a { color: var(--text); text-decoration: none; transition: color .2s var(--easing); }
        a:hover { color: var(--accent); }
        img { max-width: 100%; height: auto; display: block; }

        code {
            font-family: 'JetBrains Mono', ui-monospace, "SF Mono", Menlo, monospace;
            background: var(--ink-2);
            color: var(--accent);
            padding: .15rem .4rem;
            border-radius: 4px;
            font-size: .9em;
            border: 1px solid var(--line);
        }
        pre {
            background: var(--ink-1);
            border: 1px solid var(--line);
            color: var(--text);
            padding: 1.25rem 1.5rem;
            border-radius: var(--radius-sm);
            overflow-x: auto;
            font-size: .9em;
            font-family: 'JetBrains Mono', ui-monospace, monospace;
            line-height: 1.6;
        }
        pre code { background: transparent; border: 0; padding: 0; color: inherit; }

        blockquote {
            border-left: 2px solid var(--accent-2);
            padding: .25rem 0 .25rem 1.5rem;
            margin: 2rem 0;
            font-style: italic;
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 1.25rem;
            color: var(--text);
        }

        hr { border: 0; border-top: 1px solid var(--line); margin: 3rem 0; }

        /* ------- background canvas (animated blobs) ------- */
        #bg-canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            pointer-events: none;
            background:
                radial-gradient(ellipse 80% 60% at 20% 10%, rgba(110,168,255,.10), transparent 60%),
                radial-gradient(ellipse 60% 50% at 80% 90%, rgba(255,122,217,.08), transparent 60%),
                var(--ink-0);
        }
        #bg-grain {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            opacity: .035;
            mix-blend-mode: overlay;
            background-image:
                repeating-radial-gradient(circle at 50% 50%, rgba(255,255,255,.6) 0px, rgba(255,255,255,.6) 1px, transparent 1px, transparent 3px);
        }

        /* ------- header ------- */
        .site-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 50;
            padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            transition: background .3s var(--easing), backdrop-filter .3s var(--easing), border-color .3s var(--easing);
            border-bottom: 1px solid transparent;
        }
        .site-header.scrolled {
            background: rgba(7,7,13,.7);
            backdrop-filter: saturate(150%) blur(18px);
            -webkit-backdrop-filter: saturate(150%) blur(18px);
            border-bottom: 1px solid var(--line);
        }
        .site-title {
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 1.5rem;
            color: var(--text);
            letter-spacing: -.01em;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }
        .site-title .dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--gradient);
            box-shadow: 0 0 18px rgba(180,139,255,.6);
        }
        .site-title:hover { color: var(--text); }

        .nav-toggle {
            background: transparent;
            border: 1px solid var(--line-strong);
            color: var(--text);
            padding: .5rem .75rem;
            border-radius: 999px;
            font: inherit;
            font-size: .875rem;
            cursor: pointer;
            display: none;
            align-items: center;
            gap: .5rem;
        }
        .nav-toggle:hover { border-color: var(--accent-2); }

        .site-nav {
            display: flex;
            align-items: center;
            gap: .25rem;
            padding: .35rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(13,13,24,.5);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .site-nav a {
            color: var(--text-soft);
            font-size: .875rem;
            font-weight: 500;
            padding: .45rem 1rem;
            border-radius: 999px;
            transition: all .2s var(--easing);
        }
        .site-nav a:hover { color: var(--text); background: var(--ink-3); }
        .site-nav a.cta {
            background: var(--gradient);
            color: var(--ink-0);
            font-weight: 600;
        }
        .site-nav a.cta:hover { filter: brightness(1.1); }

        @media (max-width: 760px) {
            .nav-toggle { display: inline-flex; }
            .site-nav {
                position: absolute;
                top: 100%; right: 1.25rem;
                margin-top: .5rem;
                flex-direction: column;
                align-items: stretch;
                padding: .5rem;
                background: rgba(7,7,13,.95);
                backdrop-filter: blur(20px);
                display: none;
            }
            .site-nav.open { display: flex; }
            .site-nav a { text-align: right; padding: .65rem 1rem; }
        }

        /* ------- main ------- */
        main { padding-top: 0; }
        .wrap       { max-width: var(--max);       margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }
        .wrap-prose { max-width: var(--max-prose); margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }

        section { padding: clamp(4rem, 10vw, 8rem) 0; position: relative; }
        section.tight { padding: clamp(2rem, 5vw, 4rem) 0; }

        /* ------- footer ------- */
        .site-footer {
            border-top: 1px solid var(--line);
            padding: 4rem clamp(1.25rem, 4vw, 2.5rem) 2rem;
            margin-top: 4rem;
            background: rgba(7,7,13,.6);
        }
        .site-footer .wrap {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 3rem;
            padding: 0;
        }
        .site-footer h4 { color: var(--text-mute); margin-bottom: 1rem; }
        .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
        .site-footer a { color: var(--text-soft); font-size: .9375rem; }
        .site-footer a:hover { color: var(--accent); }
        .site-footer .brand { font-family: 'Instrument Serif', Georgia, serif; font-size: 1.5rem; color: var(--text); margin: 0 0 .5rem; }
        .site-footer .colophon {
            grid-column: 1 / -1;
            border-top: 1px solid var(--line);
            margin-top: 3rem;
            padding-top: 1.5rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            color: var(--text-mute);
            font-size: .8125rem;
        }
        @media (max-width: 760px) {
            .site-footer .wrap { grid-template-columns: 1fr; gap: 2rem; }
        }

        /* ------- buttons ------- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .85rem 1.4rem;
            border-radius: 999px;
            font: inherit;
            font-weight: 500;
            font-size: .9375rem;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .25s var(--easing);
            text-decoration: none;
        }
        .btn-primary {
            background: var(--gradient);
            color: var(--ink-0);
            font-weight: 600;
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: var(--shadow-glow); color: var(--ink-0); }
        .btn-ghost {
            background: transparent;
            color: var(--text);
            border-color: var(--line-strong);
        }
        .btn-ghost:hover { border-color: var(--accent-2); color: var(--text); background: rgba(180,139,255,.08); }

        /* ------- utility ------- */
        .gradient-text {
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .25rem .75rem;
            border-radius: 999px;
            border: 1px solid var(--line-strong);
            background: var(--ink-2);
            font-size: .8125rem;
            color: var(--text-soft);
            font-family: 'JetBrains Mono', monospace;
        }
        .pill .pulse {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 8px #4ade80;
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .4; }
        }

        .meta { color: var(--text-mute); font-size: .8125rem; font-family: 'JetBrains Mono', monospace; letter-spacing: .02em; }
        .lede { font-size: 1.25rem; color: var(--text-soft); line-height: 1.5; max-width: 56ch; }

        /* ------- cards ------- */
        .card-grid {
            display: grid;
            gap: 1.25rem;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }
        .card {
            display: block;
            padding: 1.5rem;
            background: rgba(20,20,31,.5);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            color: inherit;
            transition: all .3s var(--easing);
            position: relative;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--gradient);
            opacity: 0;
            transition: opacity .3s var(--easing);
            z-index: -1;
        }
        .card:hover {
            transform: translateY(-3px);
            border-color: var(--line-strong);
            color: inherit;
            background: rgba(29,29,44,.7);
        }
        .card h3 { margin: 0 0 .5rem; font-size: 1.5rem; }
        .card p { margin: 0; color: var(--text-soft); font-size: .9375rem; }
        .card .meta { margin-bottom: .5rem; }

        /* ------- forms ------- */
        .form { display: grid; gap: 1rem; max-width: 540px; }
        .form-row { display: grid; gap: .35rem; }
        .form label { font-size: .8125rem; color: var(--text-mute); font-family: 'JetBrains Mono', monospace; letter-spacing: .03em; text-transform: uppercase; }
        .form input, .form textarea {
            font: inherit;
            font-size: 1rem;
            padding: .85rem 1rem;
            background: var(--ink-1);
            color: var(--text);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            transition: border-color .2s var(--easing), box-shadow .2s var(--easing);
            width: 100%;
        }
        .form input:focus, .form textarea:focus {
            outline: none;
            border-color: var(--accent-2);
            box-shadow: 0 0 0 3px rgba(180,139,255,.15);
        }
        .form textarea { min-height: 140px; resize: vertical; font-family: inherit; }
        .form-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
        .form-inline { display: flex; gap: .5rem; max-width: 480px; }
        .form-inline input { flex: 1; }

        /* ------- article body ------- */
        .article-body { font-size: 1.0625rem; line-height: 1.75; color: var(--text-soft); }
        .article-body :first-child { margin-top: 0; }
        .article-body h2, .article-body h3 { color: var(--text); margin-top: 2.5rem; }
        .article-body img { border-radius: var(--radius-sm); margin: 2rem auto; }
        .article-body a { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(110,168,255,.4); text-underline-offset: 4px; }
        .article-body a:hover { text-decoration-color: var(--accent); }

        /* ------- reveal-on-scroll ------- */
        [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity .8s var(--easing), transform .8s var(--easing); }
        [data-reveal].in { opacity: 1; transform: none; }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
            [data-reveal] { opacity: 1; transform: none; }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <canvas id="bg-canvas" aria-hidden="true"></canvas>
    <div id="bg-grain" aria-hidden="true"></div>

    <header class="site-header" id="site-header">
        <a class="site-title" href="/">
            <span class="dot"></span>
            {{ site.name }}
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav class="site-nav" id="site-nav">
            <a href="/projects">Projects</a>
            <a href="/news">News</a>
            <a href="/blog">Blog</a>
            {% for item in nav() %}
                {% if item.url != '/blog' %}<a href="{{ item.url }}">{{ item.label }}</a>{% endif %}
            {% endfor %}
            <a href="/#contact" class="cta">Contact</a>
        </nav>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap">
            <div>
                <p class="brand">{{ site.name }}</p>
                <p style="color:var(--text-soft);max-width:32ch;font-size:.9375rem;margin:0;">Building software, the occasional VR thing, and ideas that take longer than expected.</p>
            </div>
            <div>
                <h4>Site</h4>
                <ul>
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/news">News &amp; Press</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/#contact">Contact</a></li>
                </ul>
            </div>
            <div>
                <h4>Elsewhere</h4>
                <ul>
                    <li><a href="https://github.com/robertobendi" rel="noopener">GitHub ↗</a></li>
                    <li><a href="https://linkedin.com/in/robertobendi" rel="noopener">LinkedIn ↗</a></li>
                    <li><a href="https://twitter.com/robbendinelli" rel="noopener">Twitter ↗</a></li>
                    <li><a href="https://bsky.app/profile/robendi.com" rel="noopener">Bluesky ↗</a></li>
                </ul>
            </div>
            <div class="colophon">
                <span>© {{ "now"|date('Y') }} Roberto Bendinelli</span>
                <span>Powered by <a href="https://github.com/robertobendi/pebblestack" rel="noopener" style="color:var(--text-soft);text-decoration:underline;text-decoration-color:var(--line-strong);">Pebblestack</a></span>
            </div>
        </div>
    </footer>

    <script>
        // Sticky-header tint on scroll.
        (function () {
            var header = document.getElementById('site-header');
            if (!header) return;
            var update = function () {
                if (window.scrollY > 12) header.classList.add('scrolled');
                else header.classList.remove('scrolled');
            };
            update();
            window.addEventListener('scroll', update, { passive: true });
        })();

        // Mobile nav toggle.
        (function () {
            var btn = document.getElementById('nav-toggle');
            var nav = document.getElementById('site-nav');
            if (!btn || !nav) return;
            btn.addEventListener('click', function () {
                var open = nav.classList.toggle('open');
                btn.setAttribute('aria-expanded', String(open));
            });
            nav.addEventListener('click', function (e) {
                if (e.target.tagName === 'A') nav.classList.remove('open');
            });
        })();

        // Reveal-on-scroll.
        (function () {
            if (!('IntersectionObserver' in window)) {
                document.querySelectorAll('[data-reveal]').forEach(function (el) { el.classList.add('in'); });
                return;
            }
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in');
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
            document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        })();

        // Animated gradient blob background — vanilla port of the React MovingBackground.
        (function () {
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var canvas = document.getElementById('bg-canvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var blobs = [];
            var w = 0, h = 0;
            var palette = [
                { r: 110, g: 168, b: 255 },  // accent
                { r: 180, g: 139, b: 255 },  // accent-2
                { r: 255, g: 122, b: 217 }   // accent-3
            ];

            function resize() {
                w = canvas.clientWidth;
                h = canvas.clientHeight;
                canvas.width = Math.floor(w * dpr);
                canvas.height = Math.floor(h * dpr);
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }

            function init() {
                resize();
                blobs = [];
                var n = w < 700 ? 4 : 6;
                for (var i = 0; i < n; i++) {
                    var c = palette[i % palette.length];
                    blobs.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        baseR: 180 + Math.random() * 220,
                        vx: (Math.random() - 0.5) * 0.18,
                        vy: (Math.random() - 0.5) * 0.18,
                        phase: Math.random() * Math.PI * 2,
                        freq: 0.0006 + Math.random() * 0.0008,
                        color: c
                    });
                }
            }

            function draw(t) {
                ctx.clearRect(0, 0, w, h);
                ctx.globalCompositeOperation = 'lighter';
                for (var i = 0; i < blobs.length; i++) {
                    var b = blobs[i];
                    b.x += b.vx;
                    b.y += b.vy;
                    if (b.x < -b.baseR) b.x = w + b.baseR;
                    if (b.x > w + b.baseR) b.x = -b.baseR;
                    if (b.y < -b.baseR) b.y = h + b.baseR;
                    if (b.y > h + b.baseR) b.y = -b.baseR;
                    var r = b.baseR + Math.sin(t * b.freq + b.phase) * 30;
                    var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, r);
                    g.addColorStop(0, 'rgba(' + b.color.r + ',' + b.color.g + ',' + b.color.b + ',.16)');
                    g.addColorStop(0.6, 'rgba(' + b.color.r + ',' + b.color.g + ',' + b.color.b + ',.04)');
                    g.addColorStop(1, 'rgba(' + b.color.r + ',' + b.color.g + ',' + b.color.b + ',0)');
                    ctx.fillStyle = g;
                    ctx.beginPath();
                    ctx.arc(b.x, b.y, r, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.globalCompositeOperation = 'source-over';
                requestAnimationFrame(draw);
            }

            init();
            window.addEventListener('resize', init);
            requestAnimationFrame(draw);
        })();
    </script>
</body>
</html>
