{% extends '@theme/layout.twig' %}

{% block title %}{{ ok ? 'Thanks' : 'Try again' }} · {{ site.name }}{% endblock %}

{% block head %}
<style>
    .result { padding: 12rem 0 6rem; text-align: center; }
    .result h1 { margin: 0 0 1.5rem; }
    .result h1 em { font-style: italic; background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .result .lede { margin-left: auto; margin-right: auto; }
    .result ul {
        list-style: none;
        padding: 1rem 1.5rem;
        margin: 1.5rem auto 2rem;
        max-width: 460px;
        text-align: left;
        background: var(--ink-1);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        color: var(--text-soft);
        font-size: .9375rem;
    }
    .result ul li::before { content: '!'; color: var(--accent-3); display: inline-block; margin-right: .5rem; font-family: 'JetBrains Mono', monospace; }
    .result .actions { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem; }
</style>
{% endblock %}

{% block content %}
<section class="result">
    <div class="wrap-prose">
        {% if ok %}
            <h1>Thanks — got <em>it</em>.</h1>
            <p class="lede">Your message landed safely. I'll get back to you soon — usually within a day or two.</p>
            <div class="actions">
                <a class="btn btn-primary" href="/">Back home →</a>
                <a class="btn btn-ghost" href="/projects">See my projects</a>
            </div>
        {% else %}
            <h1>Something <em>broke</em>.</h1>
            <p class="lede">The submission didn't go through. Specifically:</p>
            <ul>
                {% for e in errors %}<li>{{ e }}</li>{% endfor %}
            </ul>
            <div class="actions">
                <a class="btn btn-ghost" href="javascript:history.back()">← Go back</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
