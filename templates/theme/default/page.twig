{% extends '@theme/layout.twig' %}
{% set meta_description = entry.field('meta_description') %}

{% block title %}{{ entry.field('title') }} · {{ site.name }}{% endblock %}

{% block head %}
<style>
    .page-head { padding: 9rem 0 2rem; }
    .page-head .crumb { color: var(--text-mute); font-family: 'JetBrains Mono', monospace; font-size: .8125rem; margin-bottom: 1.5rem; display: inline-block; }
    .page-head .crumb a { color: var(--text-mute); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; }
    .page-head .crumb a:hover { color: var(--accent); border-color: var(--accent); }
    .page-head h1 { margin: 0 0 1rem; }
    .page-head .lede {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: clamp(1.25rem, 2.5vw, 1.625rem);
        line-height: 1.4;
        color: var(--text);
        font-style: italic;
        margin: 0 0 1rem;
        max-width: 60ch;
    }
</style>
{% endblock %}

{% block content %}
<section class="page-head">
    <div class="wrap-prose">
        <a class="crumb" href="/">← Home</a>
        <h1 data-reveal>{{ entry.field('title') }}</h1>
        {% if entry.field('lede') %}<p class="lede" data-reveal>{{ entry.field('lede') }}</p>{% endif %}
    </div>
</section>

{% if entry.field('body') %}
<section class="tight">
    <article class="wrap-prose article-body" data-reveal>
        {{ entry.field('body')|markdown }}
    </article>
</section>
{% endif %}

{% if entry.slug == 'contact' %}
<section class="tight" style="padding-top:0;">
    <div class="wrap-prose">
        <form class="form" method="post" action="/forms/contact">
            <div class="form-row">
                <label for="contact-name">Name</label>
                <input id="contact-name" type="text" name="name" required autocomplete="name">
            </div>
            <div class="form-row">
                <label for="contact-email">Email</label>
                <input id="contact-email" type="email" name="email" required autocomplete="email">
            </div>
            <div class="form-row">
                <label for="contact-subject">Subject</label>
                <input id="contact-subject" type="text" name="subject">
            </div>
            <div class="form-row">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" required></textarea>
            </div>
            <input type="text" name="_hp" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button type="submit" class="btn btn-primary">Send message →</button>
        </form>
        <p style="margin-top:2.5rem;color:var(--text-mute);font-size:.875rem;">
            Or find me elsewhere:
            <a href="https://github.com/robertobendi" rel="noopener" style="color:var(--text-soft);border-bottom:1px solid var(--line-strong);padding-bottom:1px;margin:0 .25rem;">GitHub</a>·
            <a href="https://linkedin.com/in/robertobendi" rel="noopener" style="color:var(--text-soft);border-bottom:1px solid var(--line-strong);padding-bottom:1px;margin:0 .25rem;">LinkedIn</a>·
            <a href="https://twitter.com/robbendinelli" rel="noopener" style="color:var(--text-soft);border-bottom:1px solid var(--line-strong);padding-bottom:1px;margin:0 .25rem;">Twitter</a>·
            <a href="https://bsky.app/profile/robendi.com" rel="noopener" style="color:var(--text-soft);border-bottom:1px solid var(--line-strong);padding-bottom:1px;margin:0 .25rem;">Bluesky</a>
        </p>
    </div>
</section>
{% endif %}
{% endblock %}
